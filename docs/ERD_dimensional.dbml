// Faktan: en rad = en rörelse (arrivals eller departures) på en av Swedavia-flygplatserna
Table fct_flight_movements {
  movement_id varchar [pk, note: 'hash of direction, flight_id, departure_date_utc, from_iata, to_iata']
  date_key date [not null, note: 'Europe/Stockholm date of scheduled time']
  airline_id varchar [not null]
  swedavia_airport_id varchar [not null]
  other_airport_id varchar [not null]
  direction varchar [not null, note: 'ARR or DEP']
  flight_id varchar [not null] // flygnumret, ingen egen dimension
  status varchar [not null] // LAN, ACT, CAN, SCH, DEL är borta redan i staging
  scheduled_utc timestamp [not null]
  actual_utc timestamp // tom för inställda och ej genomförda flyg
  delay_seconds integer [note: 'actual minus scheduled, signed, negative = early, NULL without actual_utc']
}

Table dim_date {
  date_key date [pk]
  weekday varchar [not null]
}
// Byggs från Swedavias koder, Wikipedia läggs på med en LEFT JOIN
Table dim_airline {
  airline_id varchar [pk, note: 'hash of airline_icao']
  airline_icao varchar [not null, note: 'natural key, joins Wikipedia']
  airline_iata varchar [not null] // opålitlig - fem bolag har ICAO-koden här
  airline_name varchar [not null] // från Swedavia API, finns för alla
  airline_country varchar [not null, note: 'Wikipedia country_region, Unknown if no match exists']
}

// Byggs ifrån Swedavias KODER, Wikipedia läggs på med en LEFT JOIN
Table dim_airport {
  airport_id varchar [pk, note: 'hash of airport_iata']
  airport_iata varchar [not null, note: 'natural key, JOINS Wikipedia']
  airport_icao varchar [not null]
  airport_name varchar [not null] // Från Swedavia, t.ex "Stockholm ARN"
  city varchar [not null, note: 'Wikipedia location, Unknown if no match exists']
  country varchar [not null, note: 'Wikipedia country, Unknown if no match exists']
}

// Flera(många) rörelser per dag, per bolag och per flygplats
Ref: fct_flight_movements.date_key > dim_date.date_key
Ref: fct_flight_movements.airline_id > dim_airline.airline_id
Ref: fct_flight_movements.swedavia_airport_id > dim_airport.airport_id
Ref: fct_flight_movements.other_airport_id > dim_airport.airport_id