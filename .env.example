# Fill in: Swedavia API key, Snowflake account, the three passwords from snowflake_setup/05_users.sql, DBT_SCHEMA.
# Every other value matches snowflake_setup/ as it is.
# === Swedavia ===
SWEDAVIA_API_KEY=

# === Snowflake, shared by every tool ===
SNOWFLAKE_ACCOUNT=orgname-accountname
SNOWFLAKE_DATABASE=flights_db
SNOWFLAKE_WAREHOUSE=flights_wh

# === dlt loads the raw data ===
SNOWFLAKE_LOADER_USER=dlt_user
SNOWFLAKE_LOADER_PASSWORD=
SNOWFLAKE_LOADER_ROLE=flights_loader

# === dbt transforms ===
SNOWFLAKE_TRANSFORMER_USER=dbt_user
SNOWFLAKE_TRANSFORMER_PASSWORD=
SNOWFLAKE_TRANSFORMER_ROLE=flights_transformer
DBT_TARGET=dev
DBT_SCHEMA=dbt_<yourname>

# === Streamlit reads marts ===
SNOWFLAKE_REPORTER_USER=streamlit_user
SNOWFLAKE_REPORTER_PASSWORD=
SNOWFLAKE_REPORTER_ROLE=flights_reporter